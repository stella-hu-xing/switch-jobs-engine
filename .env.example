# ---- App ----
APP_ENV=local
LOG_LEVEL=INFO

# ---- LLM (OpenRouter, OpenAI-compatible) ----
# Leave OPENROUTER_API_KEY empty to run in offline/stub mode (deterministic fake LLM output).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Cheap model: parsing, normalization, dedup assistance
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
# Stronger model: resume tailoring, interview prep
OPENROUTER_MODEL_SMART=anthropic/claude-3.5-sonnet
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ---- Storage ----
# local | gcs
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data
GCS_BUCKET=
GCS_PREFIX=switch-jobs-engine

# ---- Observability ----
OTEL_ENABLED=false
OTEL_SERVICE_NAME=switch-jobs-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional Langfuse (LLM trace/eval inspection)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Ingestion ----
HTTP_USER_AGENT=switch-jobs-engine/0.1 (+personal job search assistant)
INGESTION_FETCH_TIMEOUT_SECONDS=30
